# /etc/taskflow/task-service.env
#
# Native PostgreSQL on this machine listens on port 5433.
# Docker PostgreSQL (if used instead) listens on port 5432.

TASK_SERVICE_HOST=127.0.0.1
TASK_SERVICE_GRPC_PORT=9091
TASK_SERVICE_DATABASE_URL=postgres://task_service:devpassword@127.0.0.1:5433/taskflow?sslmode=disable
