# Stage 1 — Native Linux (systemd + native PostgreSQL on port 5433)
TASK_SERVICE_HOST=127.0.0.1
TASK_SERVICE_GRPC_PORT=9091
TASK_SERVICE_DATABASE_URL=postgres://task_service:devpassword@127.0.0.1:5433/taskflow?sslmode=disable

GATEWAY_HTTP_ADDRESS=127.0.0.1:8080
TASK_SERVICE_GRPC_ADDRESS=127.0.0.1:9091

# Docker PostgreSQL alternative (port 5432) — use when running without native PG:
# TASK_SERVICE_DATABASE_URL=postgres://task_service:devpassword@127.0.0.1:5432/taskflow?sslmode=disable
